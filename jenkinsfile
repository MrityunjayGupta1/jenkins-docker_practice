
pipeline {
    agent any

    environment {
        IMAGE_NAME = 'my-python-app'
        CONTAINER_NAME = 'my-python-app-container'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t my-python-app:${BUILD_NUMBER} .'
                sh 'docker tag my-python-app:${BUILD_NUMBER} my-python-app:latest'
            }
        }

        stage('Test Docker Image') {
            steps {
                sh '''
                    docker run -d --rm \
                      --name my-python-test \
                      -p 5001:5000 \
                      my-python-app:${BUILD_NUMBER}

                    sleep 5
                    curl --fail http://localhost:5001/

                    docker stop my-python-test
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f my-python-app-container || true

                    docker run -d \
                      --restart unless-stopped \
                      --name my-python-app-container \
                      -p 5000:5000 \
                      my-python-app:${BUILD_NUMBER}
                '''
            }
        }
    }
}
